---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'main' | 'section' | 'article';
  narrow?: boolean;
}

const { as: Tag = 'div', narrow = false, class: className, ...attributes } = Astro.props;
---

<Tag {...attributes} class:list={['container', { 'article-width': narrow }, className]}>
  <slot />
</Tag>
