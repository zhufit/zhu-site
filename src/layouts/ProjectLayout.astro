---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/common/Container.astro';
import ProjectStatus from '../components/projects/ProjectStatus.astro';
import ArticleItem from '../components/writing/ArticleItem.astro';
import { getRelatedPosts, type Project } from '../utils/content';
import { formatDate } from '../utils/date';
import '../styles/article.css';

interface Props { project: Project; }
const { project: { data } } = Astro.props;
const related = await getRelatedPosts(data.relatedPosts);
---

<BaseLayout title={data.title} description={data.summary} image={data.cover}>
  <Container class="page-section">
    <article aria-labelledby="project-title">
      <header class="project-hero">
        <div class="project-introduction">
          <a class="project-back" href="/projects">← Projects</a>
          <h1 id="project-title">{data.title}</h1>
          <p class="project-summary">{data.summary}</p>
        </div>
        <dl class="project-facts">
          <div><dt>状态</dt><dd><ProjectStatus status={data.status} /></dd></div>
          <div>
            <dt>时间</dt>
            <dd><time datetime={data.startedAt.toISOString()}>{formatDate(data.startedAt)}</time>
              {data.endedAt && <> — <time datetime={data.endedAt.toISOString()}>{formatDate(data.endedAt)}</time></>}
            </dd>
          </div>
          {data.techStack.length > 0 && <div><dt>技术栈</dt><dd><ul class="project-stack" role="list">{data.techStack.map(tech => <li>{tech}</li>)}</ul></dd></div>}
        </dl>
      </header>
      {data.cover && <img class="project-cover" src={data.cover} alt={`${data.title} 项目封面`} loading="lazy" />}
      <div class="article-content article-width project-body"><slot /></div>
      {related.length > 0 && (
        <section class="related-writing article-width" aria-labelledby="related-writing-title">
          <h2 id="related-writing-title">Related Writing</h2>
          <ol role="list">{related.map(post => <li><ArticleItem post={post} /></li>)}</ol>
        </section>
      )}
    </article>
  </Container>
</BaseLayout>

<style>
  .project-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 0.4fr); gap: var(--space-7); padding-block-end: var(--space-7); border-block-end: 1px solid var(--color-border); }
  .project-introduction { min-inline-size: 0; overflow-wrap: anywhere; }
  .project-back { display: inline-block; margin-block-end: var(--space-5); font-size: var(--text-sm); }
  .project-summary { max-inline-size: var(--article-width); margin-block-start: var(--space-5); font-size: var(--text-h4); color: var(--color-text-secondary); }
  .project-facts { margin: 0; display: grid; align-content: start; gap: var(--space-5); }
  .project-facts dt { font-size: var(--text-sm); color: var(--color-text-secondary); }
  .project-facts dd { margin: var(--space-2) 0 0; overflow-wrap: anywhere; }
  .project-stack { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin: 0; padding: 0; list-style: none; font-family: var(--font-mono); font-size: var(--text-sm); }
  .project-cover { inline-size: 100%; block-size: auto; margin-block-start: var(--space-7); border-radius: var(--radius-sm); }
  .project-body { margin-block-start: var(--space-7); }
  .related-writing { margin-block-start: var(--space-8); padding-block-start: var(--space-6); border-block-start: 1px solid var(--color-border); }
  .related-writing h2 { font-size: var(--text-h3); }
  .related-writing ol { margin: var(--space-5) 0 0; padding: 0; list-style: none; }
  .related-writing li { border-block-start: 1px solid var(--color-border); }
  @media (width < 768px) {
    .project-hero { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); padding-block-end: var(--space-6); }
    .project-body, .project-cover { margin-block-start: var(--space-6); }
  }
</style>
